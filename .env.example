# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_careerguide
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_careerguide

# Security & Authentication (OWASP ASVS Level 2, Argon2id, JWT)
SECRET_KEY=ai_careerguide_super_secret_jwt_key_2026_owasp_compliant_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services Configuration (LlamaIndex Dual RAG, DeepSeek / OpenAI)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.xah.io/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_MODEL=deepseek-4.1-flash-ckey
TAVILY_API_KEY=your_tavily_api_key_here

# Server & Environment Settings
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 3-Pillar Scoring Weights (Default: RIASEC 0.45, Academic 0.35, Preference 0.20)
WEIGHT_RIASEC=0.45
WEIGHT_ACADEMIC=0.35
WEIGHT_PREFERENCE=0.20
